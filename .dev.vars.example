# HTTP endpoint is an origin; the WebDAV mount goes in BACKEND_ROOT.
BACKEND_NAME="Public resources"
BACKEND_TRANSPORT="http"
BACKEND_ENDPOINT="https://files.example.com"
BACKEND_ROOT="/dav/"
BACKEND_AUTH="none"
GATEWAY_AUTH="false"

# Alternative: the HTTPS WebTransport URL of webtransport-bridge.
# BACKEND_TRANSPORT="webtransport"
# BACKEND_ENDPOINT="https://bridge.example.com:4433/webtransport"
# BACKEND_ROOT="/public/"
# CERTIFICATE_MODE="pinned"
# GATEWAY_AUTH="true"
# Bind PINS KV for rotating certificates, or set CERTIFICATES_JSON locally.
# CERTIFICATES_JSON='{"version":1,"certificates":[{"algorithm":"sha-256","value":"BASE64_SHA256","notBefore":"...","notAfter":"..."}]}'
# CERT_WEBHOOK_SECRET is a secret, not a public configuration value.
