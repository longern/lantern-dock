{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lantern-dock",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-04",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "vars": {},
  // Wrangler >=4.45 reuses this deployed binding or provisions it on first deploy.
  "kv_namespaces": [{ "binding": "KV" }],
}
