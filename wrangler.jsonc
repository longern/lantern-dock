{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lantern-dock",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "BACKEND_NAME": "Public files",
    "BACKEND_TRANSPORT": "http",
    "BACKEND_ENDPOINT": "https://files.example.com",
    "BACKEND_ROOT": "/dav/",
    "BACKEND_AUTH": "none",
    "GATEWAY_AUTH": "false",
    "CERTIFICATE_MODE": "pinned"
  }
  // For automatic WebTransport certificate pin updates, create and bind KV:
  // , "kv_namespaces": [{"binding":"PINS", "id":"YOUR_NAMESPACE_ID"}]
}
